          "fallback_used",
          "issued_at",
          "resolution_minutes",
          "intervals"
        ],
        "title": "PvForecastResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "description": "Its own Postgres: not_configured when DATABASE_URL is unset (forecasts in memory).",
