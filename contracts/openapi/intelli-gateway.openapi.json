  "info": {
    "description": "AI helper for site engineers: Claude answers questions about a generation site using read-only tools",
    "title": "intelli-gateway",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "description": "Dependency-free liveness check (the Docker HEALTHCHECK hits it).",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "description": "Ready to serve: its own Postgres answers (when one is configured). The deploy waits on it.",
        "operationId": "readyz_api_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "The database is unreachable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/forecast/health": {
      "get": {
        "operationId": "forecast_health_api_v1_forecast_health_get",
        "parameters": [
          {
            "description": "Dev auth: user id.",
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: user id.",
              "title": "X-User-Id"
            }
          },
          {
            "description": "Dev auth: comma-separated roles.",
            "in": "header",
            "name": "x-roles",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated roles.",
              "title": "X-Roles"
            }
          },
          {
            "description": "Dev auth: comma-separated site ids the user may access.",
            "in": "header",
            "name": "x-site-ids",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated site ids the user may access.",
              "title": "X-Site-Ids"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "PV forecast health: active provider, fallbacks, last success per site",
        "tags": [
          "forecast"
        ]
      }
    },
    "/api/v1/forecast/refresh": {
      "post": {
        "operationId": "refresh_forecast_api_v1_forecast_refresh_post",
        "parameters": [
          {
            "description": "One site; omit for every forecastable site",
            "in": "query",
            "name": "site_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One site; omit for every forecastable site",
              "title": "Site Id"
            }
          },
          {
            "description": "Dev auth: user id.",
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: user id.",
              "title": "X-User-Id"
            }
          },
          {
            "description": "Dev auth: comma-separated roles.",
            "in": "header",
            "name": "x-roles",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated roles.",
              "title": "X-Roles"
            }
          },
          {
            "description": "Dev auth: comma-separated site ids the user may access.",
            "in": "header",
            "name": "x-site-ids",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated site ids the user may access.",
              "title": "X-Site-Ids"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Fetch new PV forecasts now (admin)",
        "tags": [
          "forecast"
        ]
      }
    },
