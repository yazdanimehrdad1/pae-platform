    "/api/v1/sites/{site_id}/ask": {
      "post": {
        "operationId": "ask_api_v1_sites__site_id__ask_post",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "title": "Site Id",
              "type": "integer"
            }
