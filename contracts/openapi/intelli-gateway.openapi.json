{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Continue an earlier conversation; omit to start a new one.",
            "title": "Conversation Id"
          },
          "question": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "iterations": {
            "title": "Iterations",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "stop_reason": {
            "description": "end_turn (normal), max_tokens, refusal, max_iterations or timeout.",
            "title": "Stop Reason",
            "type": "string"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallResponse"
            },
            "title": "Tool Calls",
            "type": "array"
          },
          "usage": {
            "$ref": "#/components/schemas/UsageResponse"
          }
        },
        "required": [
          "conversation_id",
          "answer",
          "stop_reason",
          "iterations",
          "model",
          "tool_calls",
          "usage"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "SiteResponse": {
        "properties": {
          "capacity_kw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity Kw"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "site_id": {
            "title": "Site Id",
            "type": "integer"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "site_id",
          "name",
          "description",
          "capacity_kw",
          "timezone"
        ],
        "title": "SiteResponse",
        "type": "object"
      },
      "ToolCallResponse": {
        "properties": {
          "args": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Args",
            "type": "object"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "number"
          },
          "is_error": {
            "title": "Is Error",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "summary": {
            "description": "The start of the tool result, for display and debugging.",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "name",
          "args",
          "summary",
          "duration_ms",
          "is_error"
        ],
        "title": "ToolCallResponse",
        "type": "object"
      },
      "ToolSpecResponse": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "title": "ToolSpecResponse",
        "type": "object"
      },
      "UsageResponse": {
        "properties": {
          "cache_creation_input_tokens": {
            "title": "Cache Creation Input Tokens",
            "type": "integer"
          },
          "cache_read_input_tokens": {
            "title": "Cache Read Input Tokens",
            "type": "integer"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          }
        },
        "required": [
          "input_tokens",
          "output_tokens",
          "cache_read_input_tokens",
          "cache_creation_input_tokens"
        ],
        "title": "UsageResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "AI helper for site engineers: Claude answers questions about a generation site using read-only tools",
    "title": "intelli-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "description": "Dependency-free liveness check (the Docker HEALTHCHECK hits it).",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/sites": {
      "get": {
        "operationId": "list_sites_api_v1_sites_get",
        "parameters": [
          {
            "description": "Dev auth: user id.",
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: user id.",
              "title": "X-User-Id"
            }
          },
          {
            "description": "Dev auth: comma-separated roles.",
            "in": "header",
            "name": "x-roles",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated roles.",
              "title": "X-Roles"
            }
          },
          {
            "description": "Dev auth: comma-separated site ids the user may access.",
            "in": "header",
            "name": "x-site-ids",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated site ids the user may access.",
              "title": "X-Site-Ids"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteResponse"
                  },
                  "title": "Response List Sites Api V1 Sites Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sites the user can access",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/sites/{site_id}/ask": {
      "post": {
        "operationId": "ask_api_v1_sites__site_id__ask_post",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "title": "Site Id",
              "type": "integer"
            }
          },
          {
            "description": "Dev auth: user id.",
            "in": "header",
            "name": "x-user-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: user id.",
              "title": "X-User-Id"
            }
          },
          {
            "description": "Dev auth: comma-separated roles.",
            "in": "header",
            "name": "x-roles",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated roles.",
              "title": "X-Roles"
            }
          },
          {
            "description": "Dev auth: comma-separated site ids the user may access.",
            "in": "header",
            "name": "x-site-ids",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dev auth: comma-separated site ids the user may access.",
              "title": "X-Site-Ids"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ask a question about a site",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/tools": {
      "get": {
        "operationId": "list_tools_api_v1_tools_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ToolSpecResponse"
                  },
                  "title": "Response List Tools Api V1 Tools Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Tool specs Claude can call (mirrors MCP list_tools; for debugging)",
        "tags": [
          "v1"
        ]
      }
    }
  }
}
