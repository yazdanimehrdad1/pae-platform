# Rendered at container start by the nginx image's envsubst step (only set variables are
# substituted): ${API_UPSTREAM} is the backend-ot base URL, e.g. http://backend-ot:8000.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Same-origin API: the browser calls /api/* here and nginx forwards it unchanged
    # (no URI part on proxy_pass, so the /api prefix is kept). No CORS needed.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live register stream: server-sent events read with fetch (src/api/sse.ts). Buffering
    # would hold events back until the buffer fills, so pass them straight through.
    location /api/modbus-live-stream-raw-registers/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Vite's hashed build output: the file name changes with the content, so cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Runtime config, written at container start: never cache.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # The app shell must always be revalidated so a deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: client-side routes (e.g. /sites/manage) get index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
