# Rendered at container start by the nginx image's envsubst step (only set variables are
# substituted): ${API_UPSTREAM} is the backend-ot base URL, e.g. http://backend-ot:8000, and
# ${POWERFLOW_UPSTREAM} the powerflow simulator's, e.g. http://powerflow:8000, and
# ${INTELLI_GATEWAY_UPSTREAM} intelli-gateway's, e.g. http://intelli-gateway:8000.
# ${NGINX_RESOLVER} is the DNS server for those names (Docker's 127.0.0.11 by default; the cluster
# DNS on Kubernetes).
#
# Each proxy_pass goes through a variable, so nginx resolves the upstream per request (cached for
# `valid`) instead of once at start: nginx starts even while an upstream is down or not deployed,
# and that route answers 502 until it is back.

# Login check for backend-ot and powerflow (/api, /powerflow-api): nginx asks intelli-gateway, which
# owns PlusDAS users, whether the session cookie is valid (GET /api/v1/me), and answers 401 if not.
# A valid answer is cached per session for 60 s (so a revoked session can reach these APIs for up to
# a minute), never a 401. While intelli-gateway is down, sessions it confirmed in the last hour are
# still let through (stale cache); new logins wait for it. The cookie is intelli-gateway's
# `plusdas_session`. The cache lives in /var/cache/nginx (writable in the nginx image; a read-only
# or unprivileged container needs a tmpfs there).
proxy_cache_path /var/cache/nginx/auth levels=1 keys_zone=auth_sessions:1m max_size=10m inactive=1h use_temp_path=off;
map $cookie_plusdas_session $no_session {
    ""      1;
    default 0;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # Compress JSON (readings are 1+ MB for a day's window) and the app's text assets. Not
    # text/event-stream: gzip would buffer the live stream's events.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    set $api_upstream ${API_UPSTREAM};
    set $powerflow_upstream ${POWERFLOW_UPSTREAM};
    set $intelli_gateway_upstream ${INTELLI_GATEWAY_UPSTREAM};

    # The login check (see the top of this file). Internal: only auth_request reaches it.
    location = /_auth {
        internal;
        proxy_pass $intelli_gateway_upstream/api/v1/me;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_cache auth_sessions;
        proxy_cache_key $cookie_plusdas_session;
        proxy_cache_valid 200 60s;
        proxy_cache_bypass $no_session;
        proxy_no_cache $no_session;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
        # /me re-issues the cookie when it slides the session; that answer is still cacheable.
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
    }

    # Health and readiness checks stay open (no session needed): the deploy checks /api/readyz
    # through this origin.
    location = /api/healthz {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /api/readyz {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /powerflow-api/health {
        rewrite ^/powerflow-api/(.*)$ /api/$1 break;
        proxy_pass $powerflow_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Same-origin API, logged-in users only: the browser calls /api/* here and nginx forwards it
    # unchanged (with a
    # variable and no URI part, proxy_pass sends the request URI as is). No CORS needed.
    location /api/ {
        auth_request /_auth;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The powerflow simulator's API, same origin too: /powerflow-api/x is forwarded as /api/x
    # (the rewrite does the prefix swap; query strings are kept). Used by the Simulation page.
    location /powerflow-api/ {
        auth_request /_auth;
        rewrite ^/powerflow-api/(.*)$ /api/$1 break;
        proxy_pass $powerflow_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # intelli-gateway's API (login, the user's data, the PV forecast), same origin, checked by the
    # gateway itself: /intelli-gateway-api/x
    # is forwarded as /api/x.
    location /intelli-gateway-api/ {
        rewrite ^/intelli-gateway-api/(.*)$ /api/$1 break;
        proxy_pass $intelli_gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live register stream: server-sent events read with fetch (src/api/sse.ts). Buffering
    # would hold events back until the buffer fills, so pass them straight through.
    location /api/modbus-live-stream-raw-registers/ {
        auth_request /_auth;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Vite's hashed build output: the file name changes with the content, so cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Runtime config, written at container start: never cache.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # The app shell must always be revalidated so a deploy is picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback: client-side routes (e.g. /sites/manage) get index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
