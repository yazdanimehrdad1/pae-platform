# Copy to .env and adjust as needed. All values shown are the defaults.
# Read by the container at START (compose env_file), never at build time: the same image runs
# in every environment. Vite's build does not read this file.

# Base URL the SPA calls for the API, written into /config.js at container start.
# Keep it a same-origin path: nginx proxies /api/* to backend-ot, so no CORS is involved.
APP_API_BASE_URL=/api

# Where nginx forwards /api/* (the backend-ot base URL, no path).
# Standalone default: backend-ot's host port. Set by compose from WEB_PLUSDAS_API_UPSTREAM;
# the dev stack uses http://backend-ot:8000.
# API_UPSTREAM=http://host.docker.internal:8000

# Base URL the Simulation page calls for the powerflow simulator. Same-origin: nginx proxies
# /powerflow-api/* to powerflow's /api/*.
APP_POWERFLOW_BASE_URL=/powerflow-api

# Where nginx forwards /powerflow-api/* (the powerflow base URL, no path). Standalone default:
# powerflow's host port; set by compose from WEB_PLUSDAS_POWERFLOW_UPSTREAM; the dev stack uses
# http://powerflow:8000.
# POWERFLOW_UPSTREAM=http://host.docker.internal:8020

# Host-side overrides (shell, not this file):
#   WEB_PLUSDAS_HTTP_PORT=5173        host port of the container (compose)
#   WEB_PLUSDAS_API_UPSTREAM=...      nginx upstream for a standalone `make up`
#   WEB_PLUSDAS_DEV_API_TARGET=http://localhost:8000   Vite dev-server /api proxy target (`make run`)
#   WEB_PLUSDAS_POWERFLOW_UPSTREAM=...  nginx /powerflow-api upstream for a standalone `make up`
#   WEB_PLUSDAS_DEV_POWERFLOW_TARGET=http://localhost:8020   Vite /powerflow-api proxy target
