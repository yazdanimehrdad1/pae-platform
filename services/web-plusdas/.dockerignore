# Dependencies and build output (rebuilt inside the image)
node_modules/
dist/
dist-ssr/
coverage/
.vite/

# Environment variables (never baked into the image; config is read at container start)
.env
.env.*

# Editor / OS / agent files
.git/
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Docs
*.md
docs/

# Docker / compose / make (not needed inside the build context; docker/ itself is needed)
.dockerignore
compose*.yaml
docker-compose*.yaml
Makefile

# Host-side checks and unused mock fixtures are not shipped
scripts/
Tests/
