# Copy to .env and adjust as needed. All values shown are the defaults.
# Loaded by app/settings.py from this directory (any CWD); real env vars win over it.

# Aggregator mode: all devices on one server, addressed by unit_id.
AGGREGATOR_ENABLED=true
MODBUS_HOST=0.0.0.0
MODBUS_PORT=502

# Per-device mode: each device on its own host/port from its device file.
PER_DEVICE_ENABLED=false

# Value returned for any address not in a device's register map.
DEFAULT_REGISTER_VALUE=0

# Python log level (DEBUG, INFO, WARNING, ...).
LOG_LEVEL=INFO

# Integer seed for deterministic output. Leave empty for non-deterministic.
RANDOM_SEED=

# Addressing base: false = 1-based (Modbus Poll / most PLCs; wire address N reads key N+1),
# true = 0-based raw PDU. Keep false for the platform: backend-ot's devices are configured
# modbus_address_mode=one_based and subtract 1 before sending, exactly like a real PLC client.
ZERO_MODE=false

# Profile registers (type="profile_static") — these only pick WHICH row of the frozen
# table a read lands on, never the value. Offset on top of UTC for where solar noon falls
# (no DST), and real minutes per simulated day (1440 = real time; e.g. 2 to demo a day).
PROFILE_TIMEZONE_OFFSET_HOURS=0.0
PROFILE_DAY_MINUTES=1440.0
