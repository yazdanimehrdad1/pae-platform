# Copy to .env and adjust as needed. All values shown are the defaults.

# Aggregator mode: all devices on one server, addressed by unit_id.
AGGREGATOR_ENABLED=true
MODBUS_HOST=0.0.0.0
MODBUS_PORT=502

# Per-device mode: each device on its own host/port from its device file.
PER_DEVICE_ENABLED=false

# Value returned for any address not in a device's register map.
DEFAULT_REGISTER_VALUE=0

# Python log level (DEBUG, INFO, WARNING, ...).
LOG_LEVEL=INFO

# Integer seed for deterministic output. Leave empty for non-deterministic.
RANDOM_SEED=

# Addressing base: false = 1-based (Modbus Poll / most PLCs),
# true = 0-based raw PDU (e.g. pymodbus client).
ZERO_MODE=false
