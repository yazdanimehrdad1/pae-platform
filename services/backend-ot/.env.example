# rtac_modbus_server — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
# The real `.env` is gitignored and NEVER shipped to the cluster.
# In Kubernetes these values come from a ConfigMap (non-secret) and a Secret
# (the two passwords, sourced from GCP Secret Manager) via `envFrom`.
#
# `src/config.py` is the source of truth for which variables exist and their
# defaults; this file documents them. Only POSTGRES_PASSWORD / REDIS_PASSWORD
# are secrets — everything else is plain config.

# ---------------------------------------------------------------------------
# Modbus (aggregator / device polling)
# ---------------------------------------------------------------------------
AGGREGATOR_MODBUS_HOST=localhost
AGGREGATOR_MODBUS_PORT=502
AGGREGATOR_SERVER_ID=1
MODBUS_TIMEOUT_S=5.0
MODBUS_RETRIES=3

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Redis (cache + scheduler leader election / job locks)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# SECRET — leave unset if Redis AUTH is disabled (default). In GKE this comes
# from the k8s Secret when Memorystore AUTH is enabled.
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_DEFAULT_TTL=3600
CACHE_KEY_PREFIX=rtac_modbus

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rtac_modbus
POSTGRES_USER=rtac_user
# SECRET — REQUIRED. No default in config.py: a missing value fails startup.
# In GKE this comes from the k8s Secret (GCP Secret Manager).
POSTGRES_PASSWORD=change-me
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Scheduler (Redis leader election — safe for multiple replicas)
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_LEADER_LOCK_TTL=30
SCHEDULER_HEARTBEAT_INTERVAL=10
SCHEDULER_JOB_LOCK_TTL=300
SCHEDULER_LEADER_RETRY_INTERVAL=5

# ---------------------------------------------------------------------------
# Polling job
# ---------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=10
POLL_CACHE_TTL=3600
POLL_DEVICE_NAME=main-sel-751

# ---------------------------------------------------------------------------
# Kubernetes / cross-service
# ---------------------------------------------------------------------------
# POD_NAME is injected via the downward API in k8s; leave unset locally
# (falls back to HOSTNAME). Used for scheduler leader identity.
POD_NAME=
DAS_API_BASE_URL=http://pae-das-api:8080

# ---------------------------------------------------------------------------
# Container entrypoint
# ---------------------------------------------------------------------------
# Whether docker/entrypoint.sh runs DB migrations before starting the app.
# Keep true locally/compose. In k8s the app Deployment sets this false and a
# dedicated migration Job owns the schema.
RUN_MIGRATIONS_ON_START=true
