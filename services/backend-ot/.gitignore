# backend-ot-specific ignores. Generic rules (Python caches, venvs, .env, IDE, OS,
# Claude local files) live in the monorepo root .gitignore.

# Python packaging output — scoped to this service so they can't match another
# service's source directories (e.g. a frontend's src/lib/)
build/
develop-eggs/
downloads/
lib/
lib64/
parts/
sdist/
var/
share/python-wheels/
.installed.cfg
MANIFEST

# Local databases
*.db
*.sqlite
*.sqlite3
logs/

# Kubernetes secrets
/secrets
*.secret.yaml

# TimescaleDB
/data

# GCloud
gcloud-notes.md
