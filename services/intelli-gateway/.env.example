# intelli-gateway settings for running on the host (`make run`, tests). Copy to .env (never
# committed). In containers, compose sets API_HOST/API_PORT in `environment:`.
# Host ports are NOT set here: see the root .env.example (INTELLI_GATEWAY_HTTP_PORT).

LOG_LEVEL=INFO

# --- Claude (Anthropic API) ---
# Required for /api/v1/sites/{id}/ask. Never commit a real key.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high                 # low | medium | high | xhigh | max
# CLAUDE_MAX_TOKENS=16000
# CLAUDE_REQUEST_TIMEOUT_S=120
# CLAUDE_REFUSAL_FALLBACK=true       # server-side fallback on refusals (Claude API only)

# --- Agent loop ---
# AGENT_MAX_ITERATIONS=10
# AGENT_TIMEOUT_S=180

# --- Site knowledge ---
# KNOWLEDGE_TOKEN_WARN=150000        # warn above this size (signal to add search/RAG)

# --- Tool output bounds ---
# TOOL_MAX_OUTPUT_CHARS=20000
# TOOL_MAX_ROWS=50
# TOOL_HISTORY_SAMPLES=12
# TOOL_HISTORY_MAX_DAYS=31
# DATA_STALE_AFTER_S=600             # no new reading for longer = stale (device not reporting)

# --- Connectors ---
# true: fictional in-memory sites. false: site data from backend-ot (knowledge starts empty).
USE_FAKE_DATA=true
# BACKEND_OT_URL=http://localhost:8000      # in the dev stack compose sets http://backend-ot:8000
# BACKEND_OT_TIMEOUT_S=10
# BACKEND_OT_RETRIES=3
# BACKEND_OT_CATALOG_TTL_S=60               # how long a site's devices and points are cached

# --- Database (this service's own Postgres) ---
# Unset = forecasts kept in memory (lost on restart). In containers compose sets it to
# intelli-gateway-postgres; on the host the dev stack's Postgres is on port 5437.
# DATABASE_URL=postgresql+asyncpg://intelli_gateway:intelli_gateway@localhost:5437/intelli_gateway

# --- PV forecast (README: src/intelli_gateway/solar_forecast/README.md) ---
# FORECAST_ENABLED=true
# FORECAST_SOURCE=open_meteo               # open_meteo | noaa_hrrr (stub) | fake | fake_pv_power
# FORECAST_FALLBACK_SOURCES=               # comma-separated, tried in order when the primary fails
# FORECAST_HORIZON_HOURS=72
# FORECAST_RESOLUTION_MINUTES=15           # 15 | 60
# FORECAST_FETCH_INTERVAL_MINUTES=15       # 0 = no periodic job (POST /api/v1/forecast/refresh only)
# FORECAST_RETENTION_DAYS=90
# Open-Meteo. The free hosted API is non-commercial only: production needs a paid key
# (https://customer-api.open-meteo.com) or a self-hosted server. Never commit a real key.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# OPEN_METEO_API_KEY=
# OPEN_METEO_TIMEOUT_S=15
# OPEN_METEO_RETRIES=3
# OPEN_METEO_MAX_CALLS_PER_MINUTE=500
