            "description": "Validated (schema, references, profile scenarios exist) before it's written. Saving the active site reloads it, so the simulation must be stopped (409 otherwise).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema_version\": 1,\n  \"site\": {\n    \"name\": \"My site (copy of small_1bess_1pv)\"\n  },\n  \"simulation\": {\n    \"step_s\": 1.0,\n    \"start_time\": \"2026-06-21T06:00:00Z\",\n    \"autostart\": false,\n    \"test_mode\": false,\n    \"seed\": 1,\n    \"history_size\": 3600\n  },\n  \"grid\": {\n    \"vn_kv\": 12.47,\n    \"vm_pu\": 1.0,\n    \"sc_mva\": 100.0,\n    \"x_r\": 5.0\n  },\n  \"bess\": [\n    {\n      \"id\": \"bess1\",\n      \"inverter\": {\n        \"s_rated_kva\": 2750,\n        \"p_discharge_max_kw\": 2500,\n        \"p_charge_max_kw\": 2500,\n        \"v_lv_kv\": 0.69,\n        \"priority\": \"p\",\n        \"ramp_kw_per_s\": 500\n      },\n      \"battery\": {\n        \"capacity_kwh\": 10000,\n        \"soc_initial_pct\": 50,\n        \"efficiency\": {\n          \"round_trip\": 0.9\n        }\n      },\n      \"transformer\": {\n        \"s_rated_kva\": 2750,\n        \"vn_hv_kv\": 12.47,\n        \"vn_lv_kv\": 0.69,\n        \"z_pct\": 5.75,\n        \"x_r\": 7.0\n      }\n    }\n  ],\n  \"pv\": [\n    {\n      \"id\": \"pv1\",\n      \"dc_kwp\": 6500,\n      \"loss_factor\": 0.05,\n      \"inverter\": {\n        \"s_rated_kva\": 5500,\n        \"p_max_kw\": 5000,\n        \"v_lv_kv\": 0.69\n      },\n      \"availability\": {\n        \"scenario\": \"cloudy_dynamic\",\n        \"source\": \"irradiance\"\n      },\n      \"transformer\": {\n        \"s_rated_kva\": 5500,\n        \"vn_hv_kv\": 12.47,\n        \"vn_lv_kv\": 0.69,\n        \"z_pct\": 6.0,\n        \"x_r\": 8.0\n      }\n    }\n  ],\n  \"loads\": [\n    {\n      \"id\": \"load1\",\n      \"profile\": {\n        \"scenario\": \"low_demand\"\n      }\n    }\n  ]\n}",
              "options": {
