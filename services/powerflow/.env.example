# powerflow settings for running on the host (`make run`, tests). Copy to .env (never
# committed). In containers, compose sets API_HOST/API_PORT in `environment:`.
# Host ports are NOT set here: see the root .env.example (POWERFLOW_HTTP_PORT).

LOG_LEVEL=INFO

# Configuration store (sites, Modbus maps, active site). Host runs use the standalone compose
# Postgres on its published port (`make up` starts it); in containers compose sets this.
DATABASE_URL=postgresql+asyncpg://powerflow:powerflow@localhost:5436/powerflow
# Shipped defaults (seeded into an empty database) and the profile scenario CSVs. A relative path
# is relative to services/powerflow/.
SITE_CONFIG_DIR=site_config
# Site to load at startup instead of the database's active site (optional).
# ACTIVE_SITE=small_1bess_1pv
