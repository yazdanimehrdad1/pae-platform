# Build-time only (read by app.config.ts when running `expo start` or an EAS build).
# The backend-ot URL the app talks to is set at runtime in Settings; this is only its first value.

# Your phone must reach it: use this machine's LAN IP (not localhost) and backend-ot's host port.
DEFAULT_SERVER_URL=http://192.168.1.10:8000

# Overrides the EAS project id committed in app.config.ts (only for a different Expo project).
EAS_PROJECT_ID=

# Placeholders until the store app records exist.
IOS_BUNDLE_ID=com.pae.plusdas
ANDROID_PACKAGE=com.pae.plusdas

