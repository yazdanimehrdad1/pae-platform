# prod: real sites and clients. Non-secret settings only (committed); secrets come from Secret
# Manager in pae-platform-prod (scripts/deploy.sh).
PROJECT=pae-platform-prod
LOG_LEVEL=INFO
# The site's Modbus aggregator (RTAC) is reached through the site link (deploy/PLAN.md, Stage 6).
# Until that link exists there is nothing to poll: set the real address then.
AGGREGATOR_MODBUS_HOST=site-aggregator.invalid
AGGREGATOR_MODBUS_PORT=502
# Poll (and store) every minute for now (backend-ot's default, used locally, is 10 s). Gap markers
# and the alarms' input max gap follow it (3 polls = 3 min).
POLL_INTERVAL_SECONDS=60
# The first admin (intelli-gateway creates it while there are no users).
BOOTSTRAP_ADMIN_EMAIL=admin@plusdas.local
