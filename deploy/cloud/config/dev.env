# dev: the cloud mirror of prod with non-client data. Non-secret settings only (committed);
# secrets come from Secret Manager in pae-development (scripts/deploy.sh).
PROJECT=pae-development
LOG_LEVEL=INFO
# dev's sites are powerflow simulations: the seeded devices read powerflow:502 directly, and the
# aggregator setting points at the simulator too.
AGGREGATOR_MODBUS_HOST=powerflow
AGGREGATOR_MODBUS_PORT=502
