# __SERVICE__ — standalone: `make -C services/__SERVICE__ up`.
# Also included by the monorepo dev stack (deploy/compose/dev.yaml), so it follows the
# service convention: service name = the service dir, no container_name, no external
# networks, host port overridable with __ENV_PREFIX___HTTP_PORT.
name: __SERVICE__

services:
  __SERVICE__:
    image: __SERVICE__:dev
    build:
      context: .
      dockerfile: docker/Dockerfile
    ports:
      # Host port only; inside the container nginx always listens on 80.
      - "${__ENV_PREFIX___HTTP_PORT:-__PORT__}:80"
    # Runtime settings (APP_API_BASE_URL); optional. See .env.example.
    env_file:
      - path: .env
        required: false
    environment:
      # Where nginx forwards /api/*. Standalone default: backend-ot's published host port, so
      # `make -C services/backend-ot up` + `make -C services/__SERVICE__ up` work side by side.
      # The monorepo dev stack overrides this to the `backend-ot` service name.
      - API_UPSTREAM=${__ENV_PREFIX___API_UPSTREAM:-http://host.docker.internal:8000}
    extra_hosts:
      # Docker Desktop provides host.docker.internal; this makes it resolve on Linux too.
      - "host.docker.internal:host-gateway"
    restart: unless-stopped
