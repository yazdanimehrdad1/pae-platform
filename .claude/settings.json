{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)", "PowerShell(make *)",
      "Bash(uv run *)", "PowerShell(uv run *)", "Bash(uv sync *)", "PowerShell(uv sync *)",
      "Bash(npm ci*)", "PowerShell(npm ci*)", "Bash(npm run *)", "PowerShell(npm run *)",
      "Bash(npx tsc *)", "PowerShell(npx tsc *)", "Bash(npx eslint *)", "PowerShell(npx eslint *)",
      "Bash(docker compose ps *)", "Bash(docker compose logs *)", "Bash(docker compose config *)",
      "Bash(docker compose * ps *)", "Bash(docker compose * logs *)", "Bash(docker compose * config *)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git ls-files *)", "Bash(git grep *)", "Bash(git rev-parse *)"
    ],
    "deny": [
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)",
      "Edit(**/.env)", "Edit(**/.env.local)", "Edit(**/.env.*.local)",
      "Read(**/.env.development)", "Read(**/.env.production)",
      "Edit(**/.env.development)", "Edit(**/.env.production)",
      "Bash(docker volume rm *)", "Bash(docker volume prune *)", "Bash(docker system prune *)",
      "Bash(docker compose down -v*)", "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)", "Bash(git * --no-verify*)"
    ]
  }
}
